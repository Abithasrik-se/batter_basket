DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to send CSRF-protected requests (comma separated).
# In DEBUG the usual localhost / 127.0.0.1 dev ports are trusted automatically. In production set your https domain.
DJANGO_CSRF_TRUSTED_ORIGINS=

# "postgres" (default) or "sqlite" (only for quick local tests / CI)
DB_ENGINE=postgres
DB_NAME=zeal_dev
DB_USER=zeal_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis (only needed to run background jobs)
REDIS_URL=redis://localhost:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
